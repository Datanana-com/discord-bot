APP_ENV=local

DISCORD_TOKEN=<token>
DISCORD_CLIENT_ID=<client_id>
DISCORD_CLIENT_SECRET=<client_secret>
DISCORD_BOT_TOKEN=<bot_token - sae as DISCORD_TOKEN>
DISCORD_BOT_ID=<discord bot id>

# Whether the discord bot clear command should be enabled
DISCORD_COMMAND_CLEAR=false
# Whether the discord bot count done command should be enabled
DISCORD_COMMAND_COUNT_DONE=true

# DB Connection Credentials

## Competitives
COMPETITIVES_DB_HOST=127.0.0.1
COMPETITIVES_DB_PORT=3306
COMPETITIVES_DB_USERNAME=root
COMPETITIVES_DB_PASSWORD=
COMPETITIVES_DB_DATABASE=uz

## Retakes
RETAKES_DB_HOST=127.0.0.1
RETAKES_DB_PORT=3306
RETAKES_DB_USERNAME=root
RETAKES_DB_PASSWORD=
RETAKES_DB_DATABASE=uz

# Registers the bot's slash commands (/record, /stop, /stats, /settings, /recall, /optout, /optin, /meet, /memory, /forget) when it starts
BOT_SLASH_COMMANDS=true

# Voice recording & Claude replies (see README.md, "Voice calls with Claude")
# The wake word, language, voice and Claude model below are the defaults: each server can change its own with /settings
## Where recordings, transcripts and summaries are saved; /recall answers from them
RECORDINGS_PATH=recordings
## Calls older than this many days are deleted; leave empty to keep everything
RECORDINGS_RETENTION_DAYS=
## Claude only answers when the wake word is said; leave empty to answer everything
VOICE_WAKE_WORD=claude

## Speech-to-text: whisper.cpp
WHISPER_BINARY=/home/<you>/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/<you>/whisper.cpp/models/ggml-base.bin
## Spoken language, e.g. en or pt; "auto" detects it
WHISPER_LANGUAGE=auto

## Replies: Claude Code CLI, logged in with your Claude subscription
CLAUDE_BINARY=claude
## haiku answers fastest; sonnet or opus answer better but slower
CLAUDE_MODEL=haiku

## Text-to-speech: Piper
PIPER_BINARY=/home/<you>/piper/bin/piper
PIPER_MODEL=/home/<you>/piper/voices/en_US-lessac-medium.onnx
## Converts Piper's speech for Discord; the voice library always uses the ffmpeg on your PATH
FFMPEG_BINARY=ffmpeg

## Usage statistics shown by /stats, each server's /settings, and who opted out with /optout (SQLite, created on the first start)
STATS_DATABASE=databases/stats.sqlite

# Direct messages and calls with Claude (see README.md, "Direct messages and memory" and "Memory in calls")
## Where the bot keeps what it remembers about each person, and in groups/ about each group of people it has calls with
MEMORY_PATH=memories
