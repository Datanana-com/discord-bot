#!/bin/sh
# Stands in for the Claude Code CLI: logs how it was called, then answers like
# `claude -p --output-format stream-json`, printing FAKE_CLAUDE_OUTPUT line by line.
# Claude writes its answer over time: after the first line, this pauses for
# FAKE_CLAUDE_PAUSE seconds, or until the file FAKE_CLAUDE_RESUME exists.
# FAKE_CLAUDE_LOG holds the last call. When FAKE_CLAUDE_CALLS is set, every call is also appended to it.
# A call to update a memory prints FAKE_CLAUDE_OUTPUT_MEMORY, when it is set, instead.
# A call to look something up prints FAKE_CLAUDE_OUTPUT_LOOKUP, when it is set, instead. When FAKE_CLAUDE_LOOKUP_GO
# is set, it first waits until that file exists, and deletes it: each time the file is made, one lookup goes on.
# Written to a file of its own first: a lookup and an answer can start at the same moment.
call=$(mktemp)
{
    printf '=== call ===\n'
    printf 'cwd=%s\n' "$PWD"
    printf 'api_key=%s\n' "${ANTHROPIC_API_KEY-unset}"
    for arg in "$@"; do printf 'arg=%s\n' "$arg"; done
    printf 'stdin=%s\n' "$(cat)"
} > "$call"
tail -n +2 "$call" > "${FAKE_CLAUDE_LOG:-/dev/null}"
if [ -n "${FAKE_CLAUDE_CALLS:-}" ]; then
    cat "$call" >> "$FAKE_CLAUDE_CALLS"
fi
rm -f "$call"
output=$FAKE_CLAUDE_OUTPUT
previous=
lookup=
for arg in "$@"; do
    if [ "$previous" = --system-prompt ] && [ -n "${FAKE_CLAUDE_OUTPUT_MEMORY:-}" ]; then
        case "$arg" in "You keep a Discord bot's memory"*) output=$FAKE_CLAUDE_OUTPUT_MEMORY ;; esac
    fi
    if [ "$previous" = --system-prompt ]; then
        case "$arg" in "You look things up"*) lookup=1; output=${FAKE_CLAUDE_OUTPUT_LOOKUP:-$output} ;; esac
    fi
    previous=$arg
done
if [ -n "$lookup" ] && [ -n "${FAKE_CLAUDE_LOOKUP_GO:-}" ]; then
    # At most 30 seconds, so a test that never lets it go on doesn't leave it running.
    waits=600
    while [ ! -e "$FAKE_CLAUDE_LOOKUP_GO" ] && [ "$waits" -gt 0 ]; do
        sleep 0.05
        waits=$((waits - 1))
    done
    rm -f "$FAKE_CLAUDE_LOOKUP_GO"
fi
sleep "${FAKE_CLAUDE_DELAY:-0}"
ticks=$((${FAKE_CLAUDE_PAUSE:-0} * 20))
printf '%s' "$output" | while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line"
    while [ "$ticks" -gt 0 ] && [ ! -e "${FAKE_CLAUDE_RESUME:-}" ]; do
        sleep 0.05
        ticks=$((ticks - 1))
    done
    ticks=0
done
exit "${FAKE_CLAUDE_EXIT:-0}"
