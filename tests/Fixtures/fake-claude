#!/bin/sh
# Stands in for the Claude Code CLI: logs how it was called, then answers like
# `claude -p --output-format stream-json`, printing FAKE_CLAUDE_OUTPUT line by line.
# Claude writes its answer over time: after the first line, this pauses for
# FAKE_CLAUDE_PAUSE seconds, or until the file FAKE_CLAUDE_RESUME exists.
# FAKE_CLAUDE_LOG holds the last call. When FAKE_CLAUDE_CALLS is set, every call is also appended to it.
# A call to update a memory prints FAKE_CLAUDE_OUTPUT_MEMORY, when it is set, instead. It first
# waits for as long as the file FAKE_CLAUDE_HOLD exists, for 10 seconds at most.
{
    printf 'cwd=%s\n' "$PWD"
    printf 'api_key=%s\n' "${ANTHROPIC_API_KEY-unset}"
    for arg in "$@"; do printf 'arg=%s\n' "$arg"; done
    printf 'stdin=%s\n' "$(cat)"
} > "${FAKE_CLAUDE_LOG:-/dev/null}"
if [ -n "${FAKE_CLAUDE_CALLS:-}" ]; then
    { printf '=== call ===\n'; cat "$FAKE_CLAUDE_LOG"; } >> "$FAKE_CLAUDE_CALLS"
fi
output=$FAKE_CLAUDE_OUTPUT
previous=
for arg in "$@"; do
    if [ "$previous" = --system-prompt ]; then
        case "$arg" in "You keep a Discord bot's memory"*)
            output=${FAKE_CLAUDE_OUTPUT_MEMORY:-$output}
            held=200
            while [ -e "${FAKE_CLAUDE_HOLD:-}" ] && [ "$held" -gt 0 ]; do
                sleep 0.05
                held=$((held - 1))
            done
            ;;
        esac
    fi
    previous=$arg
done
sleep "${FAKE_CLAUDE_DELAY:-0}"
ticks=$((${FAKE_CLAUDE_PAUSE:-0} * 20))
printf '%s' "$output" | while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line"
    while [ "$ticks" -gt 0 ] && [ ! -e "${FAKE_CLAUDE_RESUME:-}" ]; do
        sleep 0.05
        ticks=$((ticks - 1))
    done
    ticks=0
done
exit "${FAKE_CLAUDE_EXIT:-0}"
