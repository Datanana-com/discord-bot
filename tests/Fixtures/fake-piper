#!/bin/sh
# Stands in for piper: logs its arguments, and writes the text it receives on stdin to the --output_file path.
for arg in "$@"; do printf 'arg=%s\n' "$arg"; done > "${FAKE_PIPER_LOG:-/dev/null}"
while [ $# -gt 0 ]; do
    if [ "$1" = "--output_file" ]; then out="$2"; fi
    shift
done
cat > "$out"
