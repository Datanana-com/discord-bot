{
    "require": {
        "php": "^8.5",
        "ext-ffi": "*",
        "team-reflex/discord-php": "^10.66",
        "discord-php-helpers/voice": "^8.3",
        "react/child-process": "^0.6.7",
        "react/http": "^1.11",
        "react/promise": "^3.2",
        "vlucas/phpdotenv": "^5.7",
        "symfony/var-dumper": "^8.1",
        "illuminate/database": "^13.34"
    },
    "scripts": {
        "serve": "php index.php",
        "pint": "pint --config=pint.json",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=coverage php -d pcov.directory=. vendor/bin/phpunit --coverage-text"
        ],
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit --testsuite Bench"
        ],
        "bench:baseline": [
            "Composer\\Config::disableProcessTimeout",
            "BENCH_SAVE=1 phpunit --testsuite Bench"
        ]
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "./helpers/string.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpunit/phpunit": "^13.4",
        "react/async": "^4.3"
    }
}
