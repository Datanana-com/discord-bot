{
    "require": {
        "php": "^8.5",
        "ext-ffi": "*",
        "team-reflex/discord-php": "^10.66",
        "discord-php-helpers/voice": "^8.3",
        "react/child-process": "^0.6.7",
        "react/promise": "^3.2",
        "vlucas/phpdotenv": "^5.7",
        "symfony/var-dumper": "^8.1",
        "illuminate/database": "^13.34"
    },
    "scripts": {
        "serve": "php index.php",
        "pint": "pint --config=pint.json",
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "./helpers/main.php",
            "./helpers/string.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpunit/phpunit": "^13.4"
    }
}
